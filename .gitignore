# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml
# pubspec.lock is committed for apps (ensures reproducible builds in CI)
# pubspec.lock

# Android
android/local.properties
android/.gradle/
# google-services.json is committed as a placeholder (no real secrets).
# CI overwrites it via GOOGLE_SERVICES_JSON secret before building.
# To use real Firebase locally: run `flutterfire configure --project=arth-taxgap`
android/key.properties
*.jks
*.keystore

# IDE
.idea/
.vscode/
*.swp
*.DS_Store

# Environment / secrets
# Cover every variant, not just the bare name: tooling writes .env.local,
# .env.bak.<timestamp>, and .env.save, and a bare `.env` rule matches none of them.
.env
.env.*
*.env
!.env.example
GoogleService-Info.plist

# Firebase — generated by flutterfire configure (contains API keys)
# Commit firebase_options.dart only after reviewing it contains no secret keys.
# For extra caution you may add it here and pass keys via CI secrets instead.

# Release keystore (never commit)
android/keystore/
CLAUDE.md
HANDOFF-CURSOR.md

# Local working notes
context.md
