{
  "name": "arth-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/scripts/migrate.ts && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/scripts/migrate.js && node dist/server.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "scan:secrets": "tsx src/scripts/scan-secrets.ts",
    "test": "tsx --test test/**/*.test.ts",
    "test:security": "tsx --test test/security.test.ts",
    "provision:neon": "tsx src/scripts/provision-neon.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "google-auth-library": "^10.9.0",
    "jose": "^6.2.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
